# NovaTag Firebase Configuration
# Rename this file to .env and fill in your actual credentials from the Firebase Console
# Project Settings > General > Your apps > SDK setup and configuration

EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyA...
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=novatag-app.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=novatag-app
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=novatag-app.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
EXPO_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abc123def456
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-ABC123DEF

# Optional: Map Provider API Keys
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyA...
